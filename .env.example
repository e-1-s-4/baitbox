# ─────────────────────────────────────────────────────────────────────────────
# BaitBox configuration
#
# Copy to `.env` (docker compose reads it automatically) or export the values in
# your shell. Every setting is optional; the defaults below are what the app
# uses when the variable is unset.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dashboard / HTTP honeypot ────────────────────────────────────────────────
BAITBOX_DASHBOARD_HOST=0.0.0.0
BAITBOX_DASHBOARD_PORT=8000
# Reverse proxy? Only enable when BaitBox is behind a trusted proxy, otherwise
# attackers can spoof X-Forwarded-For and evade the block list.
BAITBOX_TRUST_PROXY=0
# Enable when the dashboard is served over HTTPS.
BAITBOX_HSTS_ENABLED=0
BAITBOX_HSTS_MAX_AGE=31536000
BAITBOX_METRICS_ENABLED=1
BAITBOX_ENABLE_REQUEST_LOGGING=1
BAITBOX_HTTP_MAX_BODY_BYTES=65536

# ── Dashboard authentication ─────────────────────────────────────────────────
# CHANGE THESE before exposing the dashboard.
BAITBOX_DASHBOARD_USER=admin
BAITBOX_DASHBOARD_PASSWORD=admin
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BAITBOX_JWT_SECRET=baitbox-super-secret-key-change-me
BAITBOX_JWT_EXPIRY_HOURS=24
# Set to 1 when the dashboard is served over HTTPS.
BAITBOX_SESSION_COOKIE_SECURE=0

# Brute-force protection for the login form (failed attempts per window per IP)
BAITBOX_LOGIN_RATE_LIMIT=10
BAITBOX_LOGIN_RATE_WINDOW_SECS=300

# ── SSH honeypot ─────────────────────────────────────────────────────────────
BAITBOX_SSH_HOST=0.0.0.0
BAITBOX_SSH_PORT=2222
BAITBOX_SSH_BACKLOG=100
BAITBOX_SSH_CHANNEL_TIMEOUT=20
# Empty = generate an ephemeral RSA host key at startup
BAITBOX_SSH_HOST_KEY=
BAITBOX_SSH_HOSTNAME=web-prod-01
BAITBOX_MAX_COMMAND_LENGTH=4096

# ── Telnet honeypot ──────────────────────────────────────────────────────────
BAITBOX_TELNET_ENABLED=1
BAITBOX_TELNET_PORT=2323

# ── Persistence ──────────────────────────────────────────────────────────────
# sqlite (default) or postgresql
BAITBOX_DB_TYPE=sqlite
BAITBOX_DB=baitbox.db
BAITBOX_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baitbox
# 0 disables pruning
BAITBOX_EVENT_RETENTION_HOURS=720
BAITBOX_MAX_EVENTS=100
# Seed a handful of demo events on first run (leave 0 in production)
BAITBOX_SEED_DEMO_DATA=0

# ── Rate limiting (connections per 60-second window) ────────────────────────
BAITBOX_RATE_LIMIT_SSH=20
BAITBOX_RATE_LIMIT_HTTP=100
BAITBOX_RATE_LIMIT_TELNET=30

# ── GeoIP enrichment ─────────────────────────────────────────────────────────
# Set to 0 to disable external lookups entirely.
BAITBOX_GEOIP_ENABLED=1

# ── Webhook alerts ───────────────────────────────────────────────────────────
# BAITBOX_WEBHOOK_URL=https://discord.com/api/webhooks/...
# BAITBOX_WEBHOOK_TYPE=discord        # discord | slack | generic
# BAITBOX_WEBHOOK_MIN_THREAT_LEVEL=LOW
BAITBOX_WEBHOOK_QUEUE_SIZE=500

# ── Session memory bounds ────────────────────────────────────────────────────
BAITBOX_MAX_SESSION_COMMANDS=500
BAITBOX_MAX_SESSIONS=1000
BAITBOX_ENABLE_SESSION_CLEANUP=1
BAITBOX_SESSION_CLEANUP_INTERVAL=300
